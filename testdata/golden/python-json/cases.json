      "indent": "[\n  NaN,\n  Infinity,\n  -Infinity\n]",
      "compact": "[NaN, Infinity, -Infinity]",
      "canonical": "[NaN,Infinity,-Infinity]",
      "ascii": "[NaN, Infinity, -Infinity]",
      "repr": "[nan, inf, -inf]",
      "encodable": true
    }
  },
  {
