{
  "name": "songframe-go-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "yarn typecheck && vite build",
    "test": "vitest run",
    "storybook": "storybook dev -p 6106 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "playwright test",
    "format:check": "prettier --check src .storybook tests *.json *.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@wailsio/runtime": "3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "storybook": "10.6.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
