{
  "title": "plan/scenes.json — реестр постановки и монтажной шкалы",
  "type": "object",
  "required": ["schema_version", "fps", "audio", "references", "visual_direction", "sequences", "scenes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "fps": {"const": 30},
    "audio": {"type": "object", "required": ["path", "end_seconds"], "additionalProperties": false,
              "properties": {"path": {"type": "string", "pattern": "^source/"}, "end_seconds": {"type": "string"}}},
    "references": {"type": "object", "additionalProperties": {
      "type": "object", "required": ["name", "path"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^source/[^.][^/]*(/[^/]+)*\\.(png|jpg|jpeg|webp)$"},
                     "short_name": {"type": "string", "minLength": 1}}}},
    "visual_direction": {"type": "string", "minLength": 1},
    "sequences": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "title", "direction"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "direction": {"type": "string"}}}},
    "scenes": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "original", "sequence", "start_frame", "end_frame_exclusive", "camera", "action", "continuity", "references", "lipsync", "card", "state_from", "state_changes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^M\\d{2}(\\.\\d+)?$"},
        "original": {"type": "string"},
        "sequence": {"type": "string"},
        "title": {"type": "string"},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame_exclusive": {"type": "integer", "minimum": 1},
        "camera": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "continuity": {"type": "string"},
        "notes": {"type": "string"},
        "references": {"type": "array", "items": {"type": "string"}},
        "lipsync": {"type": "boolean"},
        "card": {"type": "object", "required": ["primary_reference"], "additionalProperties": false,
                 "properties": {"primary_reference": {"type": "string"}}},
        "state_from": {"anyOf": [{"type": "null"}, {"type": "string"},
                                 {"type": "object", "required": ["scene", "phase"], "additionalProperties": false,
                                  "properties": {"scene": {"type": "string"}, "phase": {"enum": ["before", "after", "same"]}}}]},
        "state_changes": {"type": "object", "additionalProperties": false,
                          "properties": {"before": {"type": "object"}, "after": {"type": "object"}}}
      }}}
  }
}
