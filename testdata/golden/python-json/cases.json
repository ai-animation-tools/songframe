[
  {
    "name": "object",
    "call": "loads",
    "input": "{\"a\": 1, \"b\": 2.0, \"c\": [true, false, null], \"d\": \"текст\"}",
    "expected": {
      "indent": "{\n  \"a\": 1,\n  \"b\": 2.0,\n  \"c\": [\n    true,\n    false,\n    null\n  ],\n  \"d\": \"текст\"\n}",
      "compact": "{\"a\": 1, \"b\": 2.0, \"c\": [true, false, null], \"d\": \"текст\"}",
      "canonical": "{\"a\":1,\"b\":2.0,\"c\":[true,false,null],\"d\":\"текст\"}",
      "ascii": "{\"a\": 1, \"b\": 2.0, \"c\": [true, false, null], \"d\": \"\\u0442\\u0435\\u043a\\u0441\\u0442\"}",
      "repr": "{'a': 1, 'b': 2.0, 'c': [True, False, None], 'd': 'текст'}",
      "encodable": true
    }
  },
  {
    "name": "floats",
    "call": "loads",
    "input": "[0.1, 1e-07, 1e16, 1.5e300, 123456789012345680000.0, -0.0, 1E2, 2.50, 100.0]",
    "expected": {
      "indent": "[\n  0.1,\n  1e-07,\n  1e+16,\n  1.5e+300,\n  1.2345678901234568e+20,\n  -0.0,\n  100.0,\n  2.5,\n  100.0\n]",
      "compact": "[0.1, 1e-07, 1e+16, 1.5e+300, 1.2345678901234568e+20, -0.0, 100.0, 2.5, 100.0]",
      "canonical": "[0.1,1e-07,1e+16,1.5e+300,1.2345678901234568e+20,-0.0,100.0,2.5,100.0]",
      "ascii": "[0.1, 1e-07, 1e+16, 1.5e+300, 1.2345678901234568e+20, -0.0, 100.0, 2.5, 100.0]",
      "repr": "[0.1, 1e-07, 1e+16, 1.5e+300, 1.2345678901234568e+20, -0.0, 100.0, 2.5, 100.0]",
      "encodable": true
    }
  },
  {
    "name": "ints",
    "call": "loads",
    "input": "[0, -0, 12345678901234567890123, -7]",
    "expected": {
      "indent": "[\n  0,\n  0,\n  12345678901234567890123,\n  -7\n]",
      "compact": "[0, 0, 12345678901234567890123, -7]",
      "canonical": "[0,0,12345678901234567890123,-7]",
      "ascii": "[0, 0, 12345678901234567890123, -7]",
      "repr": "[0, 0, 12345678901234567890123, -7]",
      "encodable": true
    }
  },
  {
