{
  "name": "songframe",
  "desktopName": "tools.songframe.app",
  "version": "0.1.0",
  "description": "Инструменты для создания музыкального клипа с помощью AI агента",
  "private": true,
  "main": "build/app/main/index.js",
  "author": "Yarkov Aleksey",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "prepare:runtime": "node scripts/runtime/prepare-runtime.mjs",
    "smoke:runtime": "node scripts/runtime/smoke-runtime.mjs",
    "dist:linux": "yarn prepare:runtime && yarn prepare:media && yarn prepare:linux-licenses && yarn build && electron-builder --linux",
    "dist:win": "yarn prepare:runtime --target=win32-x64 && yarn prepare:media --target=win32-x64 && yarn build && electron-builder --win --x64",
    "postinstall": "node -e \"const fs=require('fs');if(!fs.existsSync('node_modules/electron/dist'))require('child_process').execFileSync(process.execPath,['node_modules/electron/install.js'],{stdio:'inherit'})\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:media": "node scripts/runtime/prepare-media.mjs",
    "prepare:linux-licenses": "node scripts/runtime/prepare-linux-licenses.mjs",
    "prepare:smoke-model": "node scripts/runtime/prepare-smoke-model.mjs",
    "smoke:appimage": "node scripts/runtime/smoke-appimage.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
