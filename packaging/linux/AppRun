#!/bin/sh
# Основано на Forktopus build/linux/appimage/AppRun (MIT), атрибуция в scripts/appimage-bootstrap/main_linux.go.
# Проверка идёт до окружения bundled GTK: системные zenity/pkexec должны
# использовать свои библиотеки. Окружение образа (PATH, LD_LIBRARY_PATH, XDG_DATA_DIRS
# и рабочий каталог WebKit) задаёт следующий за ним AppRun.wails, созданный Wails generator.
# Код 20 — договор с bootstrap (константа restart): профиль установлен, AppImage
# запускается заново, а SONGFRAME_APPIMAGE_SETUP_RETRY не даёт повторить запрос пароля.
set -eu
appdir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
status=0
"$appdir/usr/libexec/songframe-appimage" "$@" || status=$?
case "$status" in
  0) ;;
  20) export SONGFRAME_APPIMAGE_SETUP_RETRY=1; exec "$APPIMAGE" "$@" ;;
  *) exit "$status" ;;
esac
if [ "$#" -eq 1 ] && [ "$1" = --setup-apparmor ]; then
  exit 0
fi
exec "$appdir/AppRun.wails" "$@"
