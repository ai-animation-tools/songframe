#!/bin/sh
# Основано на Forktopus build/linux/appimage/AppRun (MIT), атрибуция в scripts/appimage-bootstrap/main_linux.go.
# Проверка идёт до окружения bundled GTK: системные zenity/pkexec должны
# использовать свои библиотеки. AppRun.wails сохраняет рабочий каталог WebKit.
set -eu
appdir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
status=0
"$appdir/usr/libexec/songframe-appimage" "$@" || status=$?
case "$status" in
  0) ;;
  20) export SONGFRAME_GO_APPIMAGE_SETUP_RETRY=1; exec "$APPIMAGE" "$@" ;;
  *) exit "$status" ;;
esac
if [ "$#" -eq 1 ] && [ "$1" = --setup-apparmor ]; then
  exit 0
fi
exec "$appdir/AppRun.wails" "$@"
