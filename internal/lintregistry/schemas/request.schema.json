{
  "title": "request.json — общий замороженный запрос провайдера",
  "type": "object",
  "required": ["schema_version", "kind", "provider", "command", "model", "parameters", "outputs", "inputs", "prompt"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "shot": {"type": ["string", "null"]},
    "kind": {"enum": ["image", "video"]},
    "provider": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model_selection": {"type": "object", "required": ["preferredModel", "selectedModel", "reason"], "additionalProperties": false,
      "properties": {"preferredModel": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
                     "selectedModel": {"type": "string", "minLength": 1, "pattern": "\\S"},
                     "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}}},
    "parameters": {"type": "object"},
    "outputs": {"type": "integer", "minimum": 1},
    "inputs": {"type": "array", "items": {
      "type": "object", "required": ["flag", "path", "sha256", "bytes"], "additionalProperties": false,
      "properties": {"flag": {"type": "string", "minLength": 1, "pattern": "\\S"}, "slot": {"type": "string"}, "role": {"type": "string"},
                     "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "prompt": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
               "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "video_without_watermark": {"const": true}
  }
}
